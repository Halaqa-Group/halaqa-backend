{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "App"
        ]
      }
    },
    "/users": {
      "post": {
        "description": "Hashes the password (bcrypt cost 12) and optionally assigns role slugs in the same transaction. Cannot create a user in another school — `school_id` is taken from the caller.",
        "operationId": "UsersController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Email already in use",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Create a user (principal only)",
        "tags": [
          "Users"
        ]
      },
      "get": {
        "description": "Paginated and school-scoped. Soft-deleted users are excluded. Filters: `search` (substring on name/email), `role` (slug), `status`.",
        "operationId": "UsersController_list",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Substring match against name or email.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "role",
            "required": false,
            "in": "query",
            "description": "Filter by role slug (e.g. \"teacher\").",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "suspended"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "List users (principal, vice_principal)",
        "tags": [
          "Users"
        ]
      }
    },
    "/users/{id}": {
      "get": {
        "description": "Cross-school requests return 404, never 403, so user IDs are not enumerable across tenants.",
        "operationId": "UsersController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Get one user by id (principal, vice_principal)",
        "tags": [
          "Users"
        ]
      },
      "patch": {
        "description": "Cannot change email, school_id, or roles. Switching status to `inactive`/`suspended` bumps the user's `tokenVersion` and revokes every active refresh token (BR-USR-07).",
        "operationId": "UsersController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Update a user (principal only)",
        "tags": [
          "Users"
        ]
      },
      "delete": {
        "description": "Sets `deleted_at`, bumps `tokenVersion`, and revokes every active refresh token. The principal cannot delete their own account.",
        "operationId": "UsersController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "User soft-deleted (no body)"
          },
          "400": {
            "description": "Cannot delete self",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Soft-delete a user (principal only)",
        "tags": [
          "Users"
        ]
      }
    },
    "/users/{id}/roles": {
      "post": {
        "description": "Idempotent — assigning a role the user already holds is a no-op. The actor is recorded in user_roles.assigned_by.",
        "operationId": "UsersController_assignRole",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignRoleDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Unknown role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Assign a role to a user (principal only)",
        "tags": [
          "Users"
        ]
      }
    },
    "/users/{id}/roles/{roleId}": {
      "delete": {
        "operationId": "UsersController_removeRole",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "roleId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "User or role mapping not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Remove a role from a user (principal only)",
        "tags": [
          "Users"
        ]
      }
    },
    "/users/{id}/reset-password": {
      "post": {
        "description": "Hashes the supplied password with bcrypt cost 12, bumps `tokenVersion`, and revokes every active refresh token for the target user (`admin_action`).",
        "operationId": "UsersController_adminResetPassword",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminResetPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Confirmation mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Reset another user's password (principal only) — BR-USR-05",
        "tags": [
          "Users"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "description": "On success, returns an access token and the user view, and sets the `refresh_token` cookie (HttpOnly, SameSite=Strict, Path=`/auth`). All failure paths — bad password, unknown email, inactive account, rate-limited, lockout — return the same `401 Invalid credentials` shape.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSuccessEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Log in with email and password",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "description": "Reads the `refresh_token` cookie. Replaying a rotated/revoked token revokes the entire token family and returns 401 (BR-AUTH-07).",
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSuccessEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, or revoked refresh cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Rotate the refresh cookie and mint a new access token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Idempotent — clears the cookie either way and never reveals whether the token was valid.",
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Logged out (no body)"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Revoke the current refresh cookie",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/logout-all": {
      "post": {
        "description": "Kills every device session for the authenticated user. Existing access tokens still work until they expire (15 min); see BR-USR-07 for cut-on-next-request via `tokenVersion`.",
        "operationId": "AuthController_logoutAll",
        "parameters": [],
        "responses": {
          "204": {
            "description": "All sessions revoked (no body)"
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Revoke every refresh token for the caller",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/forgot-password": {
      "post": {
        "description": "Always returns 200 with the same message regardless of whether the email exists — never reveals membership. The reset token is one-time, valid for 1 hour.",
        "operationId": "AuthController_forgotPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageEnvelope"
                }
              }
            }
          }
        },
        "summary": "Request a password-reset email",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/validate-reset-token": {
      "get": {
        "description": "Read-only — does not consume the token, bump tokenVersion, or revoke anything. Used by the reset-password page to render the email and gate the form.",
        "operationId": "AuthController_validateResetToken",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateResetTokenEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Check whether a reset token is currently usable",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/reset-password": {
      "post": {
        "description": "`password` and `password_confirmation` must match (validated before any DB work). On success: bumps `tokenVersion`, revokes every active refresh token (`password_change`), and marks the reset token used.",
        "operationId": "AuthController_resetPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid token or password mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Consume a reset token and set a new password",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/sessions": {
      "get": {
        "description": "Returns one entry per active refresh token. The entry for the device that owns the current cookie is flagged with `current: true`.",
        "operationId": "SessionsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionsEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "List active sessions for the caller",
        "tags": [
          "Sessions"
        ]
      }
    },
    "/auth/sessions/{id}": {
      "delete": {
        "description": "Revokes the refresh token row identified by `id` if and only if it belongs to the caller. Cross-user requests return 404, never 403, so token IDs are not enumerable.",
        "operationId": "SessionsController_revoke",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Refresh token row id (BIGINT as string)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked (no body)"
          },
          "404": {
            "description": "Session not found or not owned by caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Revoke a specific device session",
        "tags": [
          "Sessions"
        ]
      }
    }
  },
  "info": {
    "title": "Halaqa Backend API",
    "description": "Authentication, user management, and school operations for the Halaqa system. All JSON responses are wrapped in a uniform envelope: `{ \"code\": <http>, \"data\": ... }` on success, `{ \"code\": <http>, \"message\": \"...\" }` on errors. Refresh tokens travel as HttpOnly cookies on `/auth/*`; access tokens use Bearer auth.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Login, refresh, logout, password reset"
    },
    {
      "name": "Sessions",
      "description": "List and revoke active devices"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "أحمد المدير",
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "example": "admin@school.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "Passw0rd!",
            "minLength": 8
          },
          "phone": {
            "type": "string",
            "example": "+970599123456"
          },
          "photo_url": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "suspended"
            ],
            "default": "active"
          },
          "roles": {
            "description": "Role slugs to assign at creation (e.g. [\"teacher\", \"parent\"]).",
            "example": [
              "teacher"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "أحمد المدير"
          },
          "email": {
            "type": "string",
            "example": "admin@school.com",
            "format": "email"
          },
          "phone": {
            "type": "object",
            "nullable": true,
            "example": "+970599123456"
          },
          "photoUrl": {
            "type": "object",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "suspended"
            ]
          },
          "roles": {
            "description": "Flat list of role slugs.",
            "example": [
              "principal"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lastLoginAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "photoUrl",
          "status",
          "roles",
          "lastLoginAt",
          "createdAt",
          "updatedAt"
        ]
      },
      "UserEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "example": 200
          },
          "data": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "code",
          "data"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "example": 401
          },
          "message": {
            "type": "string",
            "example": "Invalid credentials"
          },
          "details": {
            "description": "Validation error list (only on 400 with multiple field errors).",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "UserListData": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserResponse"
            }
          },
          "total": {
            "type": "number",
            "example": 42
          },
          "page": {
            "type": "number",
            "example": 1
          },
          "limit": {
            "type": "number",
            "example": 20
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "limit"
        ]
      },
      "UserListEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "example": 200
          },
          "data": {
            "$ref": "#/components/schemas/UserListData"
          }
        },
        "required": [
          "code",
          "data"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "أحمد",
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "example": "+970599123456"
          },
          "photo_url": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "suspended"
            ]
          }
        }
      },
      "AssignRoleDto": {
        "type": "object",
        "properties": {
          "roleId": {
            "type": "number",
            "example": 4,
            "description": "Numeric role id (see /roles seed)."
          }
        },
        "required": [
          "roleId"
        ]
      },
      "AdminResetPasswordDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 8
          },
          "password_confirmation": {
            "type": "string",
            "description": "Must match `password`."
          }
        },
        "required": [
          "password",
          "password_confirmation"
        ]
      },
      "MessageEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "A reset link has been sent."
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@school.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "Passw0rd!",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "أحمد المدير"
          },
          "email": {
            "type": "string",
            "example": "admin@school.com",
            "format": "email"
          },
          "roles": {
            "example": [
              "principal"
            ],
            "description": "Flat array of role slugs the user holds.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "roles"
        ]
      },
      "AuthSuccessData": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "description": "JWT access token (HS256, 15 min). Use as `Authorization: Bearer <token>`."
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserResponse"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "AuthSuccessEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "example": 200
          },
          "data": {
            "$ref": "#/components/schemas/AuthSuccessData"
          }
        },
        "required": [
          "code",
          "data"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@school.com",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ValidateResetTokenData": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@school.com",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ValidateResetTokenEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "example": 200
          },
          "data": {
            "$ref": "#/components/schemas/ValidateResetTokenData"
          }
        },
        "required": [
          "code",
          "data"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Raw token from the password-reset email link."
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "password_confirmation": {
            "type": "string",
            "description": "Must match `password`."
          }
        },
        "required": [
          "token",
          "password",
          "password_confirmation"
        ]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "42"
          },
          "deviceName": {
            "type": "object",
            "nullable": true,
            "example": null
          },
          "deviceType": {
            "type": "string",
            "enum": [
              "web",
              "mobile_ios",
              "mobile_android",
              "desktop",
              "other"
            ],
            "example": "web"
          },
          "ipAddress": {
            "type": "object",
            "nullable": true,
            "example": "1.2.3.4"
          },
          "lastUsedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "current": {
            "type": "boolean",
            "example": true,
            "description": "True for the device that owns the cookie on the current request."
          }
        },
        "required": [
          "id",
          "deviceName",
          "deviceType",
          "ipAddress",
          "lastUsedAt",
          "issuedAt",
          "current"
        ]
      },
      "SessionsEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "example": 200
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionResponse"
            }
          }
        },
        "required": [
          "code",
          "data"
        ]
      }
    }
  }
}