NODE_ENV=development
# Use a port that does not clash with Nuxt dev (3000). Must match NUXT_BACKEND_PORT in the frontend .env
PORT=8000

# Comma-separated allowed browser origins. Empty = reflect any origin in dev,
# deny cross-origin in production. Prod example:
# CORS_ORIGINS=https://app.halaqa.ps,https://admin.halaqa.ps
CORS_ORIGINS=
# Reverse-proxy hops to trust for the real client IP. 0 = direct exposure.
# Behind one nginx/ALB set 1 (otherwise login rate limiting sees the proxy IP).
TRUST_PROXY=0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=halaqa
# Dev only — keep `true` for fast iteration. Production must set `false`
# and apply schema via `pnpm migration:run`.
DB_SYNCHRONIZE=false

DEFAULT_SCHOOL_ID=1

# Launch bootstrap — used by `pnpm bootstrap:school` and `pnpm ensure:admin`
# to create the first school + principal (manager) account. Unset after use.
BOOTSTRAP_SCHOOL_NAME=Halaqa
BOOTSTRAP_SCHOOL_TIMEZONE=Asia/Hebron
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_ID_NUMBER=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

JWT_SECRET=replace-me-with-a-32-plus-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Used when the login's `rememberMe` flag is false (or absent).
JWT_REFRESH_TTL_DAYS_DEFAULT=1

BCRYPT_ROUNDS=12

# MUST be true in production (cookies only sent over HTTPS).
COOKIE_SECURE=false

# Public base URL of this API (password-reset links, etc.)
APP_URL=http://127.0.0.1:8000

# Optional: comma-separated browser origins for CORS when not using a dev proxy (production or custom setups)
# CORS_ORIGINS=https://app.example.com
MAIL_FROM="Halaqa <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
